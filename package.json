{
  "name": "vibeform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "biome check --write .",
    "lint": "vp lint",
    "test": "vitest run",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "dev:server": "vp run --filter hono dev:bare",
    "db:generate": "vp run --filter @vibeform/db db:generate",
    "deploy": "vp run --filter @vibeform/infra deploy",
    "destroy": "vp run --filter @vibeform/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@vibeform/config": "workspace:*",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "1.4.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
