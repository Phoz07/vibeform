{
  "name": "@vibeform/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate:definitions": "drizzle-kit generate --config=drizzle.definitions.config.ts",
    "db:generate:responses": "drizzle-kit generate --config=drizzle.responses.config.ts",
    "db:generate": "pnpm run db:generate:definitions && pnpm run db:generate:responses",
    "db:migrate:deploy": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "catalog:",
    "libsql": "0.5.29",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vibeform/config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
